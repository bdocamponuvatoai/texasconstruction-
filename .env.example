# Copy to .env.local for local builds. On Vercel, set these per environment.

# Canonical origin used for canonical URLs, Open Graph, JSON-LD and the sitemap.
# No trailing slash. Defaults to https://$VERCEL_PROJECT_PRODUCTION_URL on Vercel,
# otherwise http://localhost:3000.
SITE_URL=https://www.example.com

# Only "true" allows indexing (robots meta + robots.txt). Leave unset/false for
# previews; turn on only after the business owner approves the launch.
# The build fails if this is true while SITE_URL still resolves to localhost.
SITE_INDEXABLE=false
